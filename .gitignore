# --- JVM / Scala scratch ---
*.class
*.tasty
*.log
# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*

# --- Visual Studio / build output ---
.vs/
native/x64/
native/build/
**/obj/
*.dll
*.lib
*.exp
*.pdb
*.o
*.obj
*.ilk

# --- GenC output (regenerated from scala/src/main/scala/pocket/PocketPlus.scala on build) ---
native/generated/pocketplus.c
native/generated/pocketplus.h

# --- Stainless distribution (downloaded by install.sh) ---
/tools/stainless/

# --- Stainless verification artifacts ---
build/.stainless-cache/
# Coursier cache directory Stainless creates in the working dir when its cache location is unset
null/

# --- Python ---
python/env/
**/__pycache__/
.pytest_cache/

# --- Private test vectors (contents are NOT tracked) ---
/data/*
!/data/.gitkeep
!/data/README.md
/.stainless-cache
/TestResults


**/.scala-build
**/.metals
**/.bsp
**/.bloop
**/.stainless-cache
**/.vscode
**/smt_out
**/.DS_Store
stainless-stack-trace.txt
