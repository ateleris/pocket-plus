<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>b11a7c22-9d3e-4f50-8a61-1122334455aa</ProjectGuid>
    <ProjectHome>.</ProjectHome>
    <StartupFile>tests\test_roundtrip.py</StartupFile>
    <SearchPath>.</SearchPath>
    <WorkingDirectory>.</WorkingDirectory>
    <OutputPath>.</OutputPath>
    <Name>pocketplus.tests</Name>
    <RootNamespace>pocketplus</RootNamespace>
    <InterpreterId>MSBuild|env|$(MSBuildProjectFullPath)</InterpreterId>
    <TestFramework>Pytest</TestFramework>
    <UnitTestRootDirectory>tests</UnitTestRootDirectory>
    <UnitTestPattern>test*.py</UnitTestPattern>
    <!-- Directory containing the freshly built native DLL (always x64), passed to pytest. -->
    <NativeOutDir>$(MSBuildProjectDirectory)\..\native\x64\$(Configuration)\</NativeOutDir>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="pocketplus\__init__.py" />
    <Compile Include="pocketplus\_native.py" />
    <Compile Include="pocketplus\verify.py" />
    <Compile Include="tests\conftest.py" />
    <Compile Include="tests\test_roundtrip.py" />
    <Compile Include="tests\test_data_vectors.py" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="requirements.txt" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="pocketplus\" />
    <Folder Include="tests\" />
  </ItemGroup>
  <!-- VS-managed virtual environment, created/restored from requirements.txt. -->
  <ItemGroup>
    <Interpreter Include="env\">
      <Id>env</Id>
      <Version>3.13</Version>
      <Description>env (Python 3.13, 64-bit)</Description>
      <InterpreterPath>Scripts\python.exe</InterpreterPath>
      <WindowsInterpreterPath>Scripts\pythonw.exe</WindowsInterpreterPath>
      <PathEnvironmentVariable>PYTHONPATH</PathEnvironmentVariable>
      <Architecture>X64</Architecture>
    </Interpreter>
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)\Python Tools\Microsoft.PythonTools.targets" />
  <!-- Empty CoreCompile enables the Build command for a Python project (VS template guidance);
       required now that the project carries no flavor ProjectTypeGuids. -->
  <Target Name="CoreCompile" />
  <!-- Ensure the venv exists for headless (msbuild CLI) builds; VS also manages it interactively. -->
  <Target Name="EnsureVenv" BeforeTargets="RunPytest" Condition="'$(Configuration)' != 'Verify'">
    <Exec Condition="!Exists('$(MSBuildProjectDirectory)\env\Scripts\python.exe')" Command="python -m venv &quot;$(MSBuildProjectDirectory)\env&quot;" />
    <Exec Condition="!Exists('$(MSBuildProjectDirectory)\env\Scripts\pytest.exe')" Command="&quot;$(MSBuildProjectDirectory)\env\Scripts\python.exe&quot; -m pip install -r &quot;$(MSBuildProjectDirectory)\requirements.txt&quot;" />
  </Target>
  <!-- Run the interop test suite as part of Build (Debug/Release). A failing test fails the build. -->
  <Target Name="RunPytest" AfterTargets="Build" Condition="'$(Configuration)' != 'Verify'">
    <Message Importance="high" Text="[pytest] interop tests against $(NativeOutDir)" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)" EnvironmentVariables="POCKETPLUS_DLL_DIR=$(NativeOutDir)" Command="&quot;$(MSBuildProjectDirectory)\env\Scripts\python.exe&quot; -m pytest tests -q -m &quot;not verify&quot;" />
  </Target>
</Project>
