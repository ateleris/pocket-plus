<?xml version="1.0" encoding="utf-8"?>
<!-- Shared paths/properties for Stainless GenC. Imported by native/pocketplus.vcxproj.
     (Verification runs via pytest — python/tests/test_verify.py — not MSBuild.) -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)..\</RepoRoot>
    <StainlessDir>$(RepoRoot)tools\stainless\</StainlessDir>
    <StainlessJar>$(StainlessDir)lib\stainless-dotty-standalone-0.10.5.jar</StainlessJar>
    <ScalaSource>$(RepoRoot)scala\src\main\scala\pocket\PocketImperative.scala</ScalaSource>
    <!-- The data structures PocketImperative.scala is built on: GenC compiles them with it. Keep this
         list in sync with scala_srcs in native/build.sh. -->
    <BitArraySource>$(RepoRoot)scala\src\main\scala\pocket\datastructure\arrays\BitArray.scala</BitArraySource>
    <UtilsSource>$(RepoRoot)scala\src\main\scala\pocket\datastructure\Utils.scala</UtilsSource>
    <!-- The functional specification: PocketImperative.scala refers to it in its contracts and ghost
         code, so GenC has to read it, but none of it ends up in the C. -->
    <SpecSource>$(RepoRoot)scala\src\main\scala\pocket\PocketExecSpec.scala</SpecSource>
    <!-- The lemmas of the refinement proof: ghost code too, read by GenC for the same reason. -->
    <LemmasSource>$(RepoRoot)scala\src\main\scala\pocket\PocketImperativeLemmas.scala</LemmasSource>
    <GenCDir>$(RepoRoot)native\generated\</GenCDir>
    <GenCSource>$(GenCDir)pocketplus.c</GenCSource>
    <GenCHeader>$(GenCDir)pocketplus.h</GenCHeader>
    <!-- Prefer JAVA_HOME; fall back to java on PATH. -->
    <JavaExe Condition="'$(JAVA_HOME)'!=''">$(JAVA_HOME)\bin\java.exe</JavaExe>
    <JavaExe Condition="'$(JAVA_HOME)'==''">java</JavaExe>
    <!-- Deep extraction recursion needs a big stack; the unsafe-memory flag silences the JDK 23+
         sun.misc.Unsafe deprecation warnings emitted by the Scala runtime. -->
    <JvmArgs>-Xss512m --sun-misc-unsafe-memory-access=allow</JvmArgs>
  </PropertyGroup>
</Project>
