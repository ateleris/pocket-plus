<?xml version="1.0" encoding="utf-8"?>
<!-- GenC wiring: regenerate pocketplus.c from PocketImperative.scala, with the genc task of the sbt project.
     (Verification is a pytest test now — see python/tests/test_verify.py — not a build step.) -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- Regenerate the C from PocketImperative.scala and the data structures it uses, incrementally
       (only when one of the .scala files is newer).
       A real Target (not a PreBuildEvent) so the Inputs/Outputs up-to-date check works. -->
  <Target Name="GenCFromScala"
          BeforeTargets="ClCompile"
          Inputs="$(ScalaSource);$(BitArraySource);$(UtilsSource)"
          Outputs="$(GenCSource);$(GenCHeader)">
    <MakeDir Directories="$(GenCDir)" />
    <Message Importance="high" Text="[GenC] PocketImperative.scala -&gt; pocketplus.c" />
    <!-- genc writes $(GenCSource) and $(GenCHeader) -->
    <Exec WorkingDirectory="$(ScalaDir)" Command="sbt --batch genc" />
    <Error Condition="!Exists('$(GenCSource)')" Text="GenC did not produce $(GenCSource)" />
  </Target>

</Project>
