<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration><Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration><Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{6F2E9C41-7B3A-4D5E-9A1C-1A2B3C4D5E6F}</ProjectGuid>
    <RootNamespace>pocketplus</RootNamespace>
    <Keyword>Win32Proj</Keyword>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <PlatformToolset>ClangCL</PlatformToolset>
    <UseDebugLibraries Condition="'$(Configuration)' == 'Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)' == 'Release'">false</UseDebugLibraries>
    <WholeProgramOptimization Condition="'$(Configuration)' == 'Release'">true</WholeProgramOptimization>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <Import Project="$(MSBuildProjectDirectory)\..\build\Stainless.props" />

  <PropertyGroup>
    <OutDir>$(MSBuildProjectDirectory)\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(MSBuildProjectDirectory)\$(Platform)\$(Configuration)\obj\</IntDir>
    <TargetName>pocketplus</TargetName>
  </PropertyGroup>

  <!-- C99 + lint flags, the Windows counterpart of the `std`/`warn` variables in native/build.sh;
       keep the two in sync. C99 rather than C11 because the GenC output uses variable-length
       arrays, which C11 makes optional (that is also why this project needs the ClangCL toolset:
       MSVC's cl rejects VLAs outright). Under C99 they are standard, so the -Wno-vla-extension
       waiver this project used to carry is no longer needed. clang-cl only understands MSVC option
       syntax, so every GCC-style flag is escaped with /clang:.
       -Wundef is deliberately absent: the generated header tests `#elif __GNUC__>=3`. -->
  <PropertyGroup>
    <PPClangOptions>/clang:-std=c99 /clang:-pedantic /clang:-Wall /clang:-Wextra /clang:-Wshadow /clang:-Wstrict-prototypes /clang:-Wmissing-prototypes /clang:-Wpointer-arith /clang:-Wconversion /clang:-Werror</PPClangOptions>
    <!-- Waived for native/generated/ only (machine-written, never hand-edited): GenC emits an unused
         `State` local in main, and drops the parentheses the Scala already has around `a || (b && c)`.
         These must be appended *after* PPClangOptions — a later -Wall re-enables what an earlier
         -Wno- switched off. -->
    <PPClangWaiversGenerated>/clang:-Wno-unused-variable /clang:-Wno-parentheses</PPClangWaiversGenerated>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <CompileAs>CompileAsC</CompileAs>
      <!-- Language standard and warnings come from PPClangOptions below, not from the MSVC-syntax
           properties: cl.exe's LanguageStandard_C has no C99 value, and in clang-cl mode a bare
           -Wall means /Wall (≈ -Weverything). Leave these at Default so nothing fights /clang:. -->
      <LanguageStandard_C>Default</LanguageStandard_C>
      <WarningLevel>Level3</WarningLevel>
      <AdditionalIncludeDirectories>$(MSBuildProjectDirectory)\generated;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>PP_BUILD_DLL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalOptions>$(PPClangOptions) %(AdditionalOptions)</AdditionalOptions>
      <Optimization Condition="'$(Configuration)' == 'Debug'">Disabled</Optimization>
      <Optimization Condition="'$(Configuration)' == 'Release'">MaxSpeed</Optimization>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="generated\pocketplus.c">
      <AdditionalOptions>%(AdditionalOptions) $(PPClangWaiversGenerated)</AdditionalOptions>
    </ClCompile>
    <ClCompile Include="src\pp_shim.c" />
    <ClInclude Include="generated\pocketplus.h" />
    <ClInclude Include="src\pp_shim.h" />
  </ItemGroup>

  <!-- Always show the Scala source in the project for convenience. -->
  <ItemGroup>
    <None Include="..\scala\PocketPlus.scala" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Import Project="$(MSBuildProjectDirectory)\..\build\Stainless.targets" />
</Project>
