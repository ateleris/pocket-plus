<?xml version="1.0" encoding="utf-8"?>
<!-- GenC wiring: regenerate pocketplus.c from PocketPlus.scala. Invokes java directly; no scripts.
     (Verification is a pytest test now — see python/tests/test_verify.py — not a build step.) -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- Regenerate the C from PocketPlus.scala, incrementally (only when the .scala is newer).
       A real Target (not a PreBuildEvent) so the Inputs/Outputs up-to-date check works. -->
  <Target Name="GenCFromScala"
          BeforeTargets="ClCompile"
          Inputs="$(ScalaSource)"
          Outputs="$(GenCSource);$(GenCHeader)">
    <MakeDir Directories="$(GenCDir)" />
    <Message Importance="high" Text="[GenC] PocketPlus.scala -&gt; pocketplus.c" />
    <Exec WorkingDirectory="$(RepoRoot)"
          Command="&quot;$(JavaExe)&quot; $(JvmArgs) -jar &quot;$(StainlessJar)&quot; --config-file=false --genc --genc-output=&quot;$(GenCSource)&quot; &quot;$(ScalaSource)&quot;" />
    <Error Condition="!Exists('$(GenCSource)')" Text="GenC did not produce $(GenCSource)" />
  </Target>

</Project>
